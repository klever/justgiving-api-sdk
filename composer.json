{
  "name": "konsulting/justgiving-api-sdk",
  "description": "A modern PHP SDK to communicate with the JustGiving API.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Robin D'Arcy",
      "email": "robin@klever.co.uk"
    },
    {
      "name": "Keoghan Litchfield",
      "email": "keoghan@klever.co.uk"
    }
  ],
  "autoload": {
    "psr-4": {
      "Konsulting\\JustGivingApiSdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Konsulting\\JustGivingApiSdk\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.7.0",
    "illuminate/support": "^12.0",
    "nesbot/carbon": "^3.0",
    "psr/http-client": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6",
    "rector/rector": "^2.3",
    "laravel/pint": "^1.27"
  }
}
