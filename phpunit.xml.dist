<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false">

    <testsuites>
        <testsuite name="resource-clients">
            <directory>tests/ResourceClients</directory>
        </testsuite>
        <testsuite name="other">
            <directory>tests/Models</directory>
            <directory>tests/Support</directory>
            <directory>tests/Client</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
    </source>

    <php>
        <env name="API_KEY" value=""/>
    </php>
</phpunit>
